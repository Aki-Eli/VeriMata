# ─── Supabase ──────────────────────────────────────────────────────────────────
# Settings → API in your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Gemini AI ─────────────────────────────────────────────────────────────────
# Get from https://aistudio.google.com/app/apikey (free tier available)
# Used for:
#   • Quiz question generation (refill-quiz-pool)
#   • Content Analyzer page (text, link, image analysis)
GEMINI_API_KEY=your-gemini-api-key-here

# ─── SerpAPI (optional) ────────────────────────────────────────────────────────
# Used for fetching real photographs for image quiz questions
# Get from https://serpapi.com/dashboard
SERP_API_KEY=your-serp-api-key-here

# ─── Site URL ──────────────────────────────────────────────────────────────────
# Change to your Vercel URL in production (e.g. https://your-app.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3001
